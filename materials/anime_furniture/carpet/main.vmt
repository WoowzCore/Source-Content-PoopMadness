"VertexLitGeneric"
{
    "$basetexture" "anime_furniture\carpet\color"
    "$model" "1"
    "$phong" "1"

    "$bumpmap"              "anime_furniture\carpet\normal"
    "$phongboost"              1.1
    "$phongfresnelranges"      "[1 1 1]"

    "$envmap" "env_cubemap"
    "$envmaptint" "[ .2 .2 .2]"
    "$envmapsaturation" ".01"
    "$envmapcontrast" "0.1"
    "$envmapFresnel" "1"
    $normalmapalphaenvmapmask 1

 }