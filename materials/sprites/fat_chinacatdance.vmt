"Sprite"
{
"$basetexture" "sprites/fat_chinaCatDance"
"$spriteorientation" "vp_parallel"
"$spriteorigin" "[ 0.50 0.50 ]"
"$translucent" "1"
"$nocull" "1"
"$vertexcolor" "1"
"$vertexalpha" "1" 
"Proxies"
{
"AnimatedTexture"
{
"animatedTextureVar" "$basetexture"
"animatedTextureFrameNumVar" "$frame"
"animatedTextureFrameRate" "30"
}
}
}