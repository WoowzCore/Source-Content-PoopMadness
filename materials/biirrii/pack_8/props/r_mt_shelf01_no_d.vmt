VertexLitGeneric
{
	$basetexture "biirrii/pack_8/props/r_mt_shelf01_no_d"
	$bumpmap "Biirrii/Pack_8/Props/r_mt_shelf01_no_n"
	$surfaceprop Metalvent

	$detail "biirrii/shared/detail_paper"
	$detailscale 3.1
	$detailblendfactor 0.4

	$alphatest 1

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.07 0.07 0.07]"
	$envmapcontrast 0.3
	$envmapsaturation 0.4
	$envmapfresnel 0.7

	$phong 1
	$phongfresnelranges "[0.08 0.54 1]"
	$phongtint "[0.65 0.65 0.65]"
	$phongexponent 90
	$phongboost 1.1
}