VertexLitGeneric
{
	$basetexture "Biirrii/Props/Japan/BodyHandSoap1"
	$bumpmap "Biirrii/Props/Japan/BodyHandSoap1_n"
	$surfaceprop Plastic

	$detail "biirrii/shared/detail_noise"
	$detailscale 2
	$detailblendfactor 0.4

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.19 0.20 0.20]"
	$envmapsaturation 0.5
	$envmapfresnel 0.3

	$phong 1
	$phongfresnelranges "[0.1 0.55 1]"
	$phongtint "[0.77 0.77 0.77]"
	$phongexponent 33
	$phongboost 1.01
}