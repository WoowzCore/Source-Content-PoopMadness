VertexLitGeneric
{
	$basetexture "Biirrii/Props/ground/TrashPile2"
	$bumpmap "Biirrii/Props/ground/TrashPile2_n"
	$surfaceprop Plastic

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.35 0.35 0.35]"
