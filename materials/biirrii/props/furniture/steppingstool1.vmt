VertexLitGeneric
{
	$basetexture "biirrii/props/furniture/steppingstool1"
	$bumpmap "biirrii/props/furniture/steppingstool1_n"
	$surfaceprop Metal_Box

	$detail "Biirrii/Shared/detail_noise"
	$detailblendfactor 0.5

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.04 0.04 0.04]"
	$envmapsaturation 0.3
	$envmapfresnel 0.81

	$phong 1
	$phongfresnelranges "[0.04 0.52 1]"
	$phongtint "[0.82 0.82 0.82]"
	$phongexponent 8
	$phongboost 1.1
}